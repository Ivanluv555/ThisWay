<view class="container">
  <image class="bg-image" src="https://picsum.photos/1080/1920?random=travel" mode="aspectFill" />
  <view class="bg-mask"></view>

  <view class="content-wrapper">
    
    <view class="brand-section">
      <view class="logo-box">
        <text class="logo-text">Π</text>
      </view>
      <view class="text-group">
        <text class="app-en">CIDI</text>
        <text class="app-cn">此地 · 探索未知</text>
      </view>
    </view>

    <view class="action-section">
      <view class="slogan-box">
        <text class="slogan-main">Start Your Journey</text>
        <text class="slogan-sub">记录足迹，分享此刻的感动</text>
      </view>

      <button class="btn-wx" bindtap="handleWxLogin">
        <view class="wx-icon-bg">
           <text style="color:#07C160; font-weight:bold;">●</text>
        </view>
        <text>微信一键登录</text>
      </button>

      <view class="agreement-box">
        <text class="agree-text">登录即代表同意用户协议与隐私政策</text>
      </view>
    </view>
  </view>
</view>