page {
  height: 100%;
  overflow: hidden;
}

.container {
  width: 100%;
  height: 100%;
  position: relative;
  display: flex;
  flex-direction: column;
}

.bg-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: -2;
}

.bg-mask {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(to bottom, rgba(0,0,0,0.2), rgba(0,0,0,0.55));
  z-index: -1;
}

.content-wrapper {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 120rpx 60rpx 100rpx;
  box-sizing: border-box;
  color: #fff;
}

/* ===== 品牌区 ===== */
.brand-section {
  display: flex;
  align-items: center;
  margin-top: 60rpx;
}

.logo-box {
  width: 100rpx;
  height: 100rpx;
  background: rgba(255,255,255,0.2);
  backdrop-filter: blur(10px);
  border: 1rpx solid rgba(255,255,255,0.3);
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 30rpx;
}

.logo-text {
  font-size: 50rpx;
  color: #fff;
  font-weight: bold;
}

.text-group {
  display: flex;
  flex-direction: column;
}

.app-en {
  font-size: 48rpx;
  font-weight: 900;
  letter-spacing: 2px;
  line-height: 1;
  margin-bottom: 8rpx;
}

.app-cn {
  font-size: 24rpx;
  letter-spacing: 2px;
  opacity: 0.9;
  font-weight: 300;
}

/* ===== 操作区 ===== */
.action-section {
  width: 100%;
  animation: fadeInUp 0.8s ease-out;
}

/* 头像 + 昵称 */
.profile-setup {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 60rpx;
}

.avatar-picker {
  width: 140rpx;
  height: 140rpx;
  padding: 0;
  margin: 0 0 28rpx;
  background: transparent;
  border: 2rpx dashed rgba(255,255,255,0.35);
  border-radius: 50%;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: visible;
}

.avatar-picker::after {
  border: none;
}

.avatar-img {
  width: 130rpx;
  height: 130rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.12);
}

.avatar-badge {
  position: absolute;
  bottom: -4rpx;
  right: -4rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.25);
  backdrop-filter: blur(8px);
  border: 1rpx solid rgba(255,255,255,0.3);
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-badge text {
  font-size: 28rpx;
  color: #fff;
  line-height: 1;
}

.nickname-wrap {
  width: 100%;
  max-width: 480rpx;
}

.nickname-ipt {
  width: 100%;
  height: 80rpx;
  background: rgba(255,255,255,0.12);
  border-radius: 999rpx;
  text-align: center;
  font-size: 30rpx;
  color: #fff;
  padding: 0 36rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(255,255,255,0.18);
}

/* 登录按钮 */
.btn-wx {
  background: #07C160 !important;
  color: #fff;
  border-radius: 999rpx;
  padding: 0;
  height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 600;
  width: 100% !important;
  box-shadow: 0 16rpx 32rpx rgba(7, 193, 96, 0.25);
  border: none;
}

.btn-wx[disabled] {
  background: rgba(255,255,255,0.15) !important;
  color: rgba(255,255,255,0.35) !important;
  box-shadow: none;
}

.btn-wx:active {
  transform: scale(0.98);
  opacity: 0.9;
}

/* 协议 */
.agreement-box {
  margin-top: 40rpx;
  text-align: center;
}

.agree-text {
  font-size: 22rpx;
  color: rgba(255,255,255,0.5);
  line-height: 1.5;
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(40rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
