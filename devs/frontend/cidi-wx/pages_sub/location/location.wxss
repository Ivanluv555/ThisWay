.gallery { width: 100%; height: 600rpx; }
.slide-image { width: 100%; height: 100%; }

/* 基本信息卡片 */
.info-card {
  background: #fff;
  border-radius: 40rpx 40rpx 0 0;
  margin-top: -50rpx;
  position: relative;
  padding: 60rpx 40rpx;
  min-height: 50vh;
}
.header-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}
.title {
  font-size: 48rpx;
  font-weight: bold;
  color: #2C2C2C;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-right: 20rpx;
}
.nav-btn {
  background: #2C2C2C;
  color: #C1A06E;
  padding: 14rpx 40rpx;
  border-radius: 40rpx;
  font-size: 24rpx;
  font-weight: bold;
  flex-shrink: 0;
}
.meta-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}
.category-tag {
  font-size: 22rpx;
  color: #C1A06E;
  background: #fdf6ed;
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
  border: 1rpx solid #f0dbb4;
}
.rating-text {
  font-size: 24rpx;
  color: #888;
}
.address-row {
  color: #666;
  font-size: 28rpx;
  margin-bottom: 30rpx;
}

/* 内嵌拥挤度预测 */
.prediction-section {
  border-top: 1rpx solid #eee;
  padding-top: 30rpx;
  margin-bottom: 30rpx;
}
.prediction-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}
.prediction-title {
  font-weight: bold;
  font-size: 28rpx;
  color: #2C2C2C;
}
.refresh-btn {
  font-size: 22rpx;
  color: #888;
  padding: 6rpx 18rpx;
  border: 1rpx solid #ddd;
  border-radius: 30rpx;
}
.prediction-empty {
  text-align: center;
  color: #aaa;
  font-size: 26rpx;
  padding: 16rpx 0;
}

/* 预测结果 */
.result-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 24rpx;
  color: #888;
  margin-bottom: 12rpx;
}
.result-trend {
  color: #C1A06E;
  font-weight: 500;
}
.level-bar {
  height: 10rpx;
  background: #f0f0f0;
  border-radius: 5rpx;
  overflow: hidden;
  margin-bottom: 12rpx;
}
.level-inner {
  height: 100%;
  border-radius: 5rpx;
  transition: width 0.5s ease;
}
.level-0 { background: #52c41a; }
.level-1 { background: #faad14; }
.level-2 { background: #ff4d4f; }
.level-3 { background: #cf1322; }

.level-tags {
  display: flex;
  justify-content: space-between;
  margin-bottom: 12rpx;
}
.level-tag {
  font-size: 20rpx;
  color: #bbb;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  background: #f5f5f5;
}
.level-tag.active {
  color: #fff;
  font-weight: bold;
}
.level-tag-0.active { background: #52c41a; }
.level-tag-1.active { background: #faad14; }
.level-tag-2.active { background: #ff4d4f; }
.level-tag-3.active { background: #cf1322; }

.result-desc {
  font-size: 24rpx;
  color: #666;
  line-height: 1.5;
}

/* 描述 */
.desc-box {
  border-top: 1rpx solid #eee;
  padding-top: 30rpx;
}
.label {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
  color: #C1A06E;
}
.desc {
  font-size: 30rpx;
  color: #555;
  line-height: 1.6;
}
