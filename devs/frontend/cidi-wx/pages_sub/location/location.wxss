.gallery { width: 100%; height: 600rpx; }
.slide-image { width: 100%; height: 100%; }
.info-card { background: #fff; border-radius: 40rpx 40rpx 0 0; margin-top: -50rpx; position: relative; padding: 60rpx 40rpx; min-height: 50vh; }
.header-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20rpx; }
.title { font-size: 48rpx; font-weight: bold; color: #2C2C2C; }
.nav-btn { background: #2C2C2C; color: #C1A06E; padding: 14rpx 40rpx; border-radius: 40rpx; font-size: 24rpx; font-weight: bold; }
.address-row { color: #666; font-size: 28rpx; margin-bottom: 60rpx; }
.label { display: block; font-size: 28rpx; font-weight: bold; margin-bottom: 20rpx; color: #C1A06E; }
.desc { font-size: 30rpx; color: #555; line-height: 1.6; }
/* AI 卡片样式 */
.ai-card {
  background: #F0F9FF; /* 科技蓝淡背景 */
  border-radius: 16rpx;
  padding: 24rpx;
  margin: 30rpx 0;
  border: 1rpx solid rgba(24, 144, 255, 0.2);
}
.ai-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}
.ai-title {
  font-weight: bold;
  color: #1890FF;
  font-size: 28rpx;
}
.ai-btn {
  background: #1890FF;
  color: #fff;
  font-size: 24rpx;
  padding: 10rpx 24rpx;
  border-radius: 30rpx;
}

/* 结果区 */
.result-row {
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  color: #666;
  margin: 16rpx 0 10rpx;
}
.level-bar {
  height: 12rpx;
  background: #eee;
  border-radius: 6rpx;
  overflow: hidden;
  margin-bottom: 16rpx;
}
.level-inner {
  height: 100%;
  transition: width 0.5s ease;
}
/* 不同等级不同颜色 */
.level-0 { background: #52c41a; } /* 绿 */
.level-1 { background: #faad14; } /* 黄 */
.level-2 { background: #ff4d4f; } /* 红 */
.level-3 { background: #cf1322; } /* 深红 */

.result-desc {
  font-size: 26rpx;
  font-weight: 500;
  color: #333;
}