<view class="container" wx:if="{{location}}">
  <swiper class="gallery" indicator-dots autoplay circular indicator-active-color="#C1A06E">
    <block wx:for="{{location.images}}" wx:key="*this">
      <swiper-item>
        <image src="{{item}}" mode="aspectFill" class="slide-image"/>
      </swiper-item>
    </block>
  </swiper>

  <view class="info-card">
    <view class="header-row">
      <text class="title">{{location.title}}</text>
      <view class="nav-btn" bindtap="openNav">导航</view>
    </view>
    <view class="meta-row" wx:if="{{location.category || location.rating}}">
      <text class="category-tag" wx:if="{{location.category}}">{{location.category}}</text>
      <text class="rating-text" wx:if="{{location.rating}}">评分 {{location.rating}}</text>
    </view>
    <view class="address-row">
      <text class="addr">{{location.address}}</text>
    </view>

    <view class="prediction-section">
      <view class="prediction-header">
        <text class="prediction-title">拥挤度预测</text>
        <view class="refresh-btn" bindtap="fetchDetail">刷新</view>
      </view>

      <view wx:if="{{prediction}}">
        <view class="result-row">
          <text class="result-time">预计 {{prediction.predictTime}}</text>
          <text class="result-trend">{{prediction.trend}}</text>
        </view>
        <view class="level-score">拥挤指数 {{prediction.crowdIndex}} / 10 · {{prediction.levelLabel}}</view>
        <view class="level-bar">
          <view class="level-inner {{prediction.levelClass}}" style="width: {{prediction.crowdIndex * 10}}%"></view>
        </view>
        <view class="level-tags">
          <text class="level-tag level-tag-0 {{prediction.levelLabel === '舒适' ? 'active' : ''}}">舒适</text>
          <text class="level-tag level-tag-1 {{prediction.levelLabel === '一般' ? 'active' : ''}}">一般</text>
          <text class="level-tag level-tag-2 {{prediction.levelLabel === '拥挤' ? 'active' : ''}}">拥挤</text>
          <text class="level-tag level-tag-3 {{prediction.levelLabel === '非常拥挤' ? 'active' : ''}}">非常拥挤</text>
          <text class="level-tag level-tag-4 {{prediction.levelLabel === '极度拥挤' ? 'active' : ''}}">极度拥挤</text>
        </view>
        <text class="result-desc">{{prediction.desc}}</text>
      </view>

      <view wx:if="{{!prediction}}" class="prediction-empty">暂无预测数据</view>
    </view>

    <view class="desc-box" wx:if="{{location.description}}">
      <text class="label">关于此地</text>
      <text class="desc">{{location.description}}</text>
    </view>
  </view>
</view>
