/* --- 核心布局：全屏 Flex --- */
page {
  height: 100vh; /* 强制占满屏幕高度 */
  overflow: hidden; /* 禁止页面整体滚动 */
  background: #f6f7f9; /* 统一背景色 */
}

.container {
  height: 100%;
  display: flex;
  flex-direction: column; /* 垂直排列 */
  padding-bottom: 0; /* 清除默认内边距 */
}

/* 上半部分：滚动内容区 (吃掉剩余空间) */
.main-scroll {
  flex: 1; 
  height: 0; /* 关键：防止被子元素撑开 */
  width: 100%;
}

/* --- 轮播图 --- */
.gallery {
  width: 100%;
  height: 60vh; 
  background: #222;
}
.slide-image {
  width: 100%;
  height: 100%;
}

/* --- 内容区 (改为悬浮卡片式) --- */
.content-card {
  margin-top: -40rpx; /* 向上覆盖轮播图 */
  border-radius: 40rpx 40rpx 0 0;
  background: #fff;
  position: relative;
  z-index: 10;
  min-height: 50vh;
  padding-bottom: 40rpx;
}

.content-body {
  padding: 40rpx 40rpx 20rpx;
}

.title {
  font-size: 44rpx;
  font-weight: 600;
  color: #222;
  line-height: 1.4;
  margin-bottom: 30rpx;
  display: block;
}

.meta-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 30rpx;
}

.author-info {
  display: flex;
  align-items: center;
}

.author-avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: #eee;
  margin-right: 16rpx;
  border: 1rpx solid #f0f1f3;
}

.author-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
}

.date {
  font-size: 24rpx;
  color: #9097a3;
}

.desc {
  font-size: 32rpx;
  color: #444;
  line-height: 1.8;
  display: block;
  margin-bottom: 30rpx;
  white-space: pre-wrap;
}

.location-tag {
  display: inline-block;
  font-size: 24rpx;
  color: #000;
  background: #f0f2f5;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  margin-top: 10rpx;
}

/* 分割线 */
.divider {
  height: 1rpx;
  background: #f5f6f8;
  margin: 20rpx 40rpx;
}

/* --- 评论区 --- */
.comment-area {
  padding: 20rpx 40rpx 40rpx; /* 底部多留点白 */
}
.comment-count {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 30rpx;
  display: block;
}
.comment-row {
  display: flex;
  margin-bottom: 40rpx;
}
.c-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #eee;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.c-right { flex: 1; }
.c-name {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 8rpx;
  display: block;
}
.c-content {
  font-size: 28rpx;
  color: #333;
  line-height: 1.5;
}
.empty-state {
  text-align: center;
  color: #ccc;
  font-size: 26rpx;
  padding: 60rpx 0;
}

/* --- 底部互动栏 (固定在最下方) --- */
.footer-bar {
  width: 100%;
  flex-shrink: 0; /* 禁止被压缩 */
  height: 110rpx;
  background: #fff;
  border-top: 1rpx solid #f9f9f9;
  display: flex;
  align-items: center;
  padding: 0 30rpx;
  box-sizing: border-box;
  /* 适配 iPhone X 等底部安全区 */
  padding-bottom: env(safe-area-inset-bottom);
  height: calc(110rpx + env(safe-area-inset-bottom));
}

.input-box {
  flex: 1;
  height: 72rpx;
  background: #F5F5F5;
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  padding-left: 30rpx;
  margin-right: 30rpx;
  color: #999;
  font-size: 28rpx;
}

.icon-group {
  display: flex;
  align-items: center;
}

.icon-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-left: 40rpx; /* 稍微拉开点间距 */
  min-width: 60rpx;
}

/* 【修改】图标通用样式 */
.action-icon {
  width: 48rpx;
  height: 48rpx;
  margin-bottom: 4rpx;
  transition: transform 0.2s; /* 缩放过渡 */
}

/* 点击时的按压效果 */
.action-icon:active {
  transform: scale(0.8);
}

/* 【新增】点赞/收藏成功的弹跳动画 */
@keyframes bounceIn {
  0% { transform: scale(1); }
  50% { transform: scale(1.3); }
  100% { transform: scale(1); }
}

.animate-bounce {
  animation: bounceIn 0.4s ease-out;
}

.num {
  font-size: 20rpx;
  color: #333;
  font-weight: 500;
}

/* --- 弹窗输入 --- */
.input-modal {
  position: fixed;
  top: 0; left: 0; width: 100%; height: 100%;
  z-index: 999;
}
.modal-mask {
  width: 100%; height: 100%;
  background: rgba(0,0,0,0.4);
}
.modal-body {
  position: absolute;
  bottom: 0;
  width: 100%;
  background: #fff;
  padding: 30rpx;
  box-sizing: border-box;
  border-radius: 24rpx 24rpx 0 0;
  display: flex;
  align-items: flex-end;
  padding-bottom: calc(30rpx + env(safe-area-inset-bottom));
}
.real-input {
  flex: 1;
  background: #F5F5F5;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 30rpx;
  height: 160rpx; 
  margin-right: 20rpx;
}
.send-btn {
  width: 140rpx;
  height: 70rpx;
  background: #C1A06E;
  color: #fff;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 35rpx;
  margin: 0;
}