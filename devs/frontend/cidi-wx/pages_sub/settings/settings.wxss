.container {
  min-height: 100vh;
  background: #f6f7f9;
  padding: 24rpx;
  box-sizing: border-box;
}

.group {
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  border: 1rpx solid #f0f1f3;
  box-shadow: 0 8rpx 22rpx rgba(16, 24, 40, 0.05);
}

.cell-title {
  padding: 26rpx 30rpx 10rpx;
  font-size: 26rpx;
  color: #616b78;
}

.input-wrap {
  padding: 0 30rpx 16rpx;
}

.api-input {
  height: 78rpx;
  border-radius: 14rpx;
  border: 1rpx solid #e5e7eb;
  background: #fafbfc;
  padding: 0 20rpx;
  font-size: 26rpx;
  color: #1f2937;
}

.action-row {
  display: flex;
  gap: 16rpx;
  padding: 0 30rpx 10rpx;
}

.mini-btn {
  flex: 1;
  height: 70rpx;
  line-height: 70rpx;
  border-radius: 12rpx;
  background: #f3f4f6;
  color: #374151;
  font-size: 24rpx;
  margin: 0;
}

.mini-btn::after {
  border: none;
}

.mini-btn.primary {
  background: #1f2937;
  color: #f9d8a3;
}

.test-btn {
  margin: 8rpx 30rpx 12rpx;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 14rpx;
  background: #0d9488;
  color: #fff;
  font-size: 26rpx;
}

.test-btn::after {
  border: none;
}

.result {
  margin: 8rpx 30rpx 14rpx;
  padding: 16rpx 18rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
}

.result.ok {
  background: #ecfdf5;
  color: #047857;
  border: 1rpx solid #a7f3d0;
}

.result.fail {
  background: #fef2f2;
  color: #b91c1c;
  border: 1rpx solid #fecaca;
}

.tips {
  padding: 0 30rpx 24rpx;
}

.tips text {
  display: block;
  font-size: 22rpx;
  color: #6b7280;
  line-height: 1.6;
}

.logout {
  background: #fff;
  color: #ff4d4f; /* 警告红 */
  border-radius: 20rpx;
  font-size: 30rpx;
  font-weight: 500;
  padding: 32rpx 0;
  line-height: normal; /* 重置 button 默认行高 */
  border: 1rpx solid #f0f1f3;
  box-shadow: 0 8rpx 22rpx rgba(16, 24, 40, 0.05);
}

.logout:after {
  border: none; /* 去掉 button 默认边框 */
}

.logout:active {
  background: #fff5f5;
}