<view class="container">
  <view class="nav-header">
    <text class="cancel-text" bindtap="goBack">取消</text>
    <button class="pub-btn" bindtap="handlePublish" disabled="{{!content && images.length === 0}}">发布</button>
  </view>

  <view class="input-section">
    <input class="title-ipt" placeholder="加个标题哟~" placeholder-style="color:#ccc; font-weight:normal;" bindinput="onTitleInput" />
    <textarea class="content-ipt" placeholder="分享此刻的想法..." placeholder-style="color:#ccc;" maxlength="2000" bindinput="onContentInput"></textarea>
  </view>

  <view class="media-section">
    <view class="grid">
      <block wx:for="{{images}}" wx:key="*this">
        <view class="img-wrap">
          <image src="{{item}}" mode="aspectFill" class="preview-img" />
          <view class="del-tag" catchtap="removeImage" data-index="{{index}}">×</view>
        </view>
      </block>
      
      <view class="add-box" bindtap="chooseImage" wx:if="{{images.length < 9}}">
        <text class="plus-icon">+</text>
      </view>
    </view>
  </view>
</view>