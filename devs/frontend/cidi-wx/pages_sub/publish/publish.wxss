.container {
  padding: 40rpx;
  background: #fff;
  min-height: 100vh;
  box-sizing: border-box; /* 确保 padding 包含在宽度内 */
}

/* 顶部栏 */
.nav-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 40rpx; /* 稍微减小间距 */
}
.cancel-text { 
  font-size: 32rpx; 
  color: #666; 
  padding: 10rpx 0; /* 增加点击区域 */
}
.pub-btn {
  margin: 0;
  background: #222; /* 更深的黑 */
  color: #fff;
  font-size: 28rpx;
  font-weight: 500;
  padding: 0 40rpx; /* 改用 padding 撑开宽度 */
  height: 64rpx;     /* 固定高度 */
  line-height: 64rpx;
  border-radius: 999rpx; /* 全圆角 */
}
.pub-btn[disabled] { 
  background: #f0f2f5 !important; 
  color: #c0c4cc !important; 
}

/* 输入区 */
.input-section { margin-bottom: 40rpx; }
.title-ipt {
  font-size: 36rpx;
  font-weight: 600;
  height: 88rpx; /* 稍微增高 */
  border-bottom: 1rpx solid #f0f1f3;
  margin-bottom: 30rpx;
  color: #222;
}
.content-ipt {
  width: 100%;
  height: 300rpx; /* 增高输入区 */
  font-size: 30rpx;
  line-height: 1.6;
  color: #333;
}

/* 图片九宫格 */
.grid { 
  display: grid;
  grid-template-columns: repeat(3, 1fr); /* 真正的 CSS Grid */
  gap: 16rpx; 
}
.img-wrap, .add-box {
  width: 100%; /* 撑满 grid 单元 */
  aspect-ratio: 1; /* 保持正方形 */
  height: auto; /* 高度自动 */
  border-radius: 12rpx;
  position: relative;
  overflow: hidden; /* 主要是裁剪图片圆角 */
}
.preview-img { 
  width: 100%; 
  height: 100%; 
  border-radius: 12rpx; 
  object-fit: cover; /* 保持比例填充 */
}
.add-box {
  background: #f7f8fa;
  display: flex;
  align-items: center;
  justify-content: center;
}
.plus-icon { 
  font-size: 60rpx; 
  color: #d1d5db; 
  font-weight: 300; 
  margin-top: -6rpx; 
}

/* 删除角标 */
.del-tag {
  position: absolute;
  top: 8rpx; 
  right: 8rpx;
  width: 40rpx; 
  height: 40rpx;
  background: rgba(0,0,0,0.4);
  backdrop-filter: blur(4px); /* 磨砂效果 */
  color: #fff;
  border-radius: 50%;
  text-align: center;
  line-height: 36rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}