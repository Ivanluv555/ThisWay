<view class="welcome-page">
	<image class="poster-bg" src="https://cidi.oss-cn-beijing.aliyuncs.com/poster.jpg" mode="aspectFill" />
	<view class="poster-mask"></view>

	<view class="title-wrap">
		<text class="app-title-cn">{{appNameCn}}</text>
		<text class="app-title-en">{{appNameEn}}</text>
	</view>

	<view class="enter-wrap">
		<view
			class="glass-slider"
			bindtouchstart="onDragStart"
			bindtouchmove="onDragMove"
			bindtouchend="onDragEnd"
			bindtouchcancel="onDragEnd"
		>
			<view class="glass-slider-fill" style="width: {{fillWidth}}px;"></view>
			<text class="glass-slider-text">{{sliderTip}}</text>
			<view
				class="glass-slider-knob {{isDragging ? 'dragging' : ''}} {{entering ? 'entering' : ''}}"
				style="transform: translateX({{knobX}}px);"
			>
				<text class="knob-arrow">›</text>
			</view>
		</view>
	</view>
</view>