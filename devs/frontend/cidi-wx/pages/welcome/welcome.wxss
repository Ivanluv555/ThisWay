page {
	width: 100%;
	height: 100%;
}

.welcome-page {
	position: relative;
	width: 100%;
	height: 100%;
	overflow: hidden;
}

.poster-bg {
	position: absolute;
	left: 0;
	top: 0;
	width: 100%;
	height: 100%;
}

.poster-mask {
	position: absolute;
	left: 0;
	top: 0;
	width: 100%;
	height: 100%;
	background: linear-gradient(180deg, rgba(0, 0, 0, 0.26) 0%, rgba(0, 0, 0, 0.12) 40%, rgba(0, 0, 0, 0.48) 100%);
}

.title-wrap {
	position: absolute;
	left: 50%;
	top: 46%;
	transform: translate(-50%, -50%);
	width: 100%;
	padding: 0 70rpx;
	box-sizing: border-box;
	text-align: center;
}

.app-title-cn {
	display: block;
	font-size: 100rpx;
	line-height: 1.1;
	font-weight: 800;
	color: #ffffff;
	text-shadow: 0 6rpx 24rpx rgba(0, 0, 0, 0.38);
	letter-spacing: 8rpx;
}

.app-title-en {
	display: block;
	margin-top: 20rpx;
	font-size: 30rpx;
	line-height: 1.3;
	font-weight: 500;
	color: rgba(255, 255, 255, 0.9);
	letter-spacing: 10rpx;
	text-transform: uppercase;
}

.enter-wrap {
	position: absolute;
	left: 48rpx;
	right: 48rpx;
	bottom: 120rpx;
}

.glass-slider {
	position: relative;
	height: 54px;
	border-radius: 999px;
	overflow: hidden;
	background: linear-gradient(135deg, rgba(255, 255, 255, 0.44) 0%, rgba(255, 255, 255, 0.16) 100%);
	border: 1px solid rgba(255, 255, 255, 0.58);
	box-shadow: 0 12px 30px rgba(15, 23, 42, 0.22), inset 0 1px 0 rgba(255, 255, 255, 0.65);
	backdrop-filter: blur(16px) saturate(165%);
	-webkit-backdrop-filter: blur(16px) saturate(165%);
}

.glass-slider-fill {
	position: absolute;
	left: 0;
	top: 0;
	bottom: 0;
	border-radius: inherit;
	background: linear-gradient(135deg, rgba(255, 255, 255, 0.58) 0%, rgba(213, 236, 255, 0.42) 100%);
	transition: width 0.18s ease;
}

.glass-slider-text {
	position: absolute;
	left: 50%;
	top: 50%;
	transform: translate(-50%, -50%);
	z-index: 2;
	color: rgba(255, 255, 255, 0.96);
	font-size: 26rpx;
	letter-spacing: 2rpx;
	text-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.28);
	pointer-events: none;
}

.glass-slider-knob {
	position: absolute;
	left: 5px;
	top: 5px;
	z-index: 3;
	width: 44px;
	height: 44px;
	border-radius: 50%;
	display: flex;
	align-items: center;
	justify-content: center;
	background: linear-gradient(150deg, rgba(255, 255, 255, 0.94) 0%, rgba(235, 245, 255, 0.72) 100%);
	border: 1px solid rgba(255, 255, 255, 0.82);
	box-shadow: 0 8px 20px rgba(17, 24, 39, 0.25), inset 0 1px 0 rgba(255, 255, 255, 0.9);
	transition: transform 0.18s ease;
}

.glass-slider-knob.dragging {
	transition: none;
	box-shadow: 0 10px 24px rgba(17, 24, 39, 0.30), inset 0 1px 0 rgba(255, 255, 255, 0.95);
}

.glass-slider-knob.entering {
	background: linear-gradient(150deg, rgba(230, 244, 255, 0.98) 0%, rgba(195, 227, 255, 0.78) 100%);
}

.knob-arrow {
	color: #5d6f83;
	font-size: 34rpx;
	font-weight: 700;
	line-height: 1;
	transform: translateX(2rpx);
}