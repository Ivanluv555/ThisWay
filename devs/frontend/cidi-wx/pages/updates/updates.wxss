
.container {
  min-height: 100vh;
  background: #f6f7f9;
  box-sizing: border-box;
  padding-bottom: 160rpx;
}

.search-bar {
  display: flex;
  padding: 20rpx 24rpx 16rpx;
  background: #f6f7f9;
  align-items: center;
  position: sticky;
  top: 0;
  width: 100%;
  z-index: 10;
  box-sizing: border-box;
}

.search-input {
  flex: 1;
  background: #ffffff;
  border-radius: 999rpx;
  padding: 16rpx 28rpx;
  font-size: 26rpx;
  color: #333;
  border: 1rpx solid #eceff3;
}

.waterfall-container {
  display: flex;
  padding: 10rpx 12rpx 24rpx;
  width: 100%;
  box-sizing: border-box;
}

.waterfall-column {
  width: 50%;
  padding: 0 10rpx;
  box-sizing: border-box;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
  border: 1rpx solid #f0f1f3;
  box-shadow: 0 8rpx 22rpx rgba(16, 24, 40, 0.05);
}

.card-image {
  width: 100%;
  display: block;
  background: #eef0f3;
}

.card-title {
  display: block;
  font-size: 27rpx;
  padding: 18rpx 18rpx 14rpx;
  color: #222;
  font-weight: 500;
  line-height: 1.5;
}

.card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 18rpx 18rpx;
}

.card-author {
  display: flex;
  align-items: center;
}

.card-avatar {
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  background: #eee;
  margin-right: 10rpx;
}

.card-author-label {
  font-size: 22rpx;
  color: #70757f;
}

.card-likes {
  font-size: 22rpx;
  color: #c1a06e;
}

/* 悬浮按钮样式 */
.fab-btn {
  position: fixed;
  bottom: 60rpx;
  right: 40rpx;
  width: 104rpx;
  height: 104rpx;
  background: #2C2C2C; /* 深邃黑 */
  color: #C1A06E;      /* 品牌金 */
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 30rpx rgba(44, 44, 44, 0.4); /* 高级投影 */
  z-index: 100;
  transition: transform 0.2s cubic-bezier(0.25, 0.8, 0.25, 1);
}

.fab-btn text {
  font-size: 70rpx;
  font-weight: 300;
  line-height: 1;
  margin-top: -8rpx; /* 微调垂直居中 */
}

/* 点击时的缩放反馈 */
.fab-btn:active {
  transform: scale(0.9);
  box-shadow: 0 6rpx 16rpx rgba(44, 44, 44, 0.3);
}