
.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #f6f7f9 0%, #eef2f8 100%);
  box-sizing: border-box;
  padding-bottom: 160rpx;
}

.search-bar {
  display: flex;
  padding: 20rpx 24rpx 16rpx;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.72) 0%, rgba(255, 255, 255, 0.34) 100%);
  align-items: center;
  position: sticky;
  top: 0;
  width: 100%;
  z-index: 10;
  backdrop-filter: blur(16px) saturate(165%);
  -webkit-backdrop-filter: blur(16px) saturate(165%);
  box-sizing: border-box;
}

.search-input {
  flex: 1;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.76) 0%, rgba(255, 255, 255, 0.38) 100%);
  border-radius: 999rpx;
  padding: 16rpx 28rpx;
  font-size: 26rpx;
  color: #333;
  border: 1rpx solid rgba(255, 255, 255, 0.66);
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.08), inset 0 1rpx 0 rgba(255, 255, 255, 0.68);
}

.waterfall-container {
  display: flex;
  padding: 10rpx 12rpx 24rpx;
  width: 100%;
  box-sizing: border-box;
}

.waterfall-column {
  width: 50%;
  padding: 0 10rpx;
  box-sizing: border-box;
}

.card {
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.75) 0%, rgba(255, 255, 255, 0.3) 100%);
  border-radius: 20rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.62);
  box-shadow: 0 10rpx 28rpx rgba(16, 24, 40, 0.08);
  backdrop-filter: blur(14px) saturate(165%);
  -webkit-backdrop-filter: blur(14px) saturate(165%);
}

.card-image {
  width: 100%;
  display: block;
  background: #eef0f3;
}

.card-title {
  display: block;
  font-size: 27rpx;
  padding: 18rpx 18rpx 8rpx;
  color: #222;
  font-weight: 500;
  line-height: 1.5;
}

.card-summary {
  display: block;
  padding: 0 18rpx 12rpx;
  font-size: 22rpx;
  color: #6b7280;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.mini-tags {
  display: flex;
  flex-direction: column;
  padding: 14rpx 18rpx 0;
}

.mini-tag {
  display: inline-block;
  width: fit-content;
  font-size: 20rpx;
  color: #8a6226;
  background: #f8efdf;
  border-radius: 999rpx;
  padding: 3rpx 12rpx;
  margin-bottom: 8rpx;
}

.mini-loc {
  font-size: 21rpx;
  color: #7c838f;
}

.card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 18rpx 18rpx;
}

.card-author {
  display: flex;
  align-items: center;
}

.card-avatar {
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  background: #eee;
  margin-right: 10rpx;
}

.card-author-label {
  font-size: 22rpx;
  color: #70757f;
}

.card-likes {
  font-size: 22rpx;
  color: #c1a06e;
}

/* 悬浮按钮 — 固定在视口，不受页面滚动影响 */
.fab-btn {
  position: fixed;
  bottom: calc(120rpx + env(safe-area-inset-bottom));
  right: 36rpx;
  width: 100rpx;
  height: 100rpx;
  background: linear-gradient(135deg, #2c2c2c 0%, #1a1a1a 100%);
  color: #d4b87a;
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 36rpx rgba(0, 0, 0, 0.28), 0 0 0 1rpx rgba(255, 255, 255, 0.06) inset;
  z-index: 999;
  transition: transform 0.2s cubic-bezier(0.25, 0.8, 0.25, 1);
}

.fab-btn text {
  font-size: 70rpx;
  font-weight: 300;
  line-height: 1;
  margin-top: -8rpx; /* 微调垂直居中 */
}

.fab-btn:active {
  transform: scale(0.92);
  box-shadow: 0 6rpx 18rpx rgba(0, 0, 0, 0.18);
}

.empty-block {
  margin: 18rpx 24rpx 0;
  border-radius: 24rpx;
  padding: 34rpx 22rpx;
  text-align: center;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.76) 0%, rgba(255, 255, 255, 0.34) 100%);
  border: 1rpx solid rgba(255, 255, 255, 0.62);
  box-shadow: 0 10rpx 24rpx rgba(15, 23, 42, 0.08);
}

.empty-title {
  display: block;
  color: #374151;
  font-size: 30rpx;
  font-weight: 600;
}

.empty-desc {
  display: block;
  margin-top: 8rpx;
  color: #6b7280;
  font-size: 24rpx;
}