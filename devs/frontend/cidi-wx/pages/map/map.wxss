page {
  height: 100vh;
  overflow: hidden;
}

.container {
  position: relative;
  width: 100%;
  height: 100%;
}

.map-layer {
  width: 100%;
  height: 100%;
  z-index: 1;
}

/* Fullscreen toggle button */
.fs-btn {
  position: fixed;
  top: 20rpx;
  right: 24rpx;
  z-index: 20;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  backdrop-filter: blur(8px);
}

.fs-btn-text {
  font-size: 20rpx;
  color: #374151;
  font-weight: 600;
  line-height: 1;
}

.locate-btn {
  position: fixed;
  top: 106rpx;
  right: 24rpx;
  z-index: 20;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  backdrop-filter: blur(8px);
}

.locate-btn-text {
  font-size: 36rpx;
  color: #374151;
  line-height: 1;
}

/* --- 自定义 Marker 样式 --- */
.custom-marker {
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
}

.flame-badge {
  margin-bottom: 4rpx;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.flame-text {
  font-size: 18rpx;
  font-weight: 700;
  line-height: 1.4;
  white-space: nowrap;
}

.flame-0 { background: rgba(22, 163, 74, 0.18); }
.flame-0 .flame-text { color: #16a34a; }

.flame-1 { background: rgba(202, 138, 4, 0.18); }
.flame-1 .flame-text { color: #ca8a04; }

.flame-2 { background: rgba(234, 88, 12, 0.18); }
.flame-2 .flame-text { color: #ea580c; }

.flame-3 { background: rgba(220, 38, 38, 0.18); }
.flame-3 .flame-text { color: #dc2626; }

.marker-img-wrap {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.25);
}

.marker-img {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
}

.border-0 { border: 5rpx solid #16a34a; }
.border-1 { border: 5rpx solid #ca8a04; }
.border-2 { border: 5rpx solid #ea580c; }
.border-3 { border: 5rpx solid #dc2626; }
.border--1 { border: 4rpx solid #fff; }

/* Bottom drawer */
.bottom-drawer {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 100vh;
  background: #f6f7f9;
  border-radius: 32rpx 32rpx 0 0;
  z-index: 10;
  box-shadow: 0 -4rpx 30rpx rgba(0,0,0,0.08);
  display: flex;
  flex-direction: column;
  padding-bottom: env(safe-area-inset-bottom);
}

/* Animated transition for snap (added/removed by WXS) */
.drawer-animate {
  transition: transform 0.32s cubic-bezier(0.2, 0, 0, 1);
}

/* Fullscreen — hide drawer entirely */
.bottom-drawer.drawer-hidden {
  transform: translateY(100vh) !important;
  transition: transform 0.3s ease;
}

.drawer-header {
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding-bottom: 20rpx;
  flex-shrink: 0;
}

.drawer-handle {
  width: 80rpx;
  height: 8rpx;
  background: #d0d0d0;
  border-radius: 10rpx;
  margin: 16rpx auto;
}

.search-box {
  margin: 0 30rpx 20rpx;
  background: #f2f4f7;
  height: 80rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  padding: 0 30rpx;
  flex-shrink: 0;
}

.placeholder {
  font-size: 28rpx;
  color: #7f8691;
  margin-left: 20rpx;
}

.poi-list {
  flex: 1;
  height: 0;
  background: #fff;
  padding: 0 30rpx 100rpx;
  box-sizing: border-box;
}

.list-header {
  font-size: 30rpx;
  font-weight: 600;
  color: #222;
  margin: 20rpx 0;
}

.poi-card {
  display: flex;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f5f6f8;
}

.poi-img {
  width: 200rpx;
  height: 150rpx;
  border-radius: 16rpx;
  background: #eee;
  flex-shrink: 0;
  margin-right: 24rpx;
}

.poi-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-width: 0;
}

.poi-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #222;
  line-height: 1.4;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.poi-desc {
  font-size: 24rpx;
  color: #888;
  margin-top: 8rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  line-height: 1.5;
}

.poi-meta {
  display: flex;
  align-items: center;
  margin-top: 12rpx;
}

.distance {
  font-size: 22rpx;
  color: #a0a6b0;
  margin-right: 20rpx;
}

.tag {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-weight: 500;
}

.tag-0 { color: #16a34a; background: rgba(22, 163, 74, 0.1); }
.tag-1 { color: #ca8a04; background: rgba(202, 138, 4, 0.1); }
.tag-2 { color: #ea580c; background: rgba(234, 88, 12, 0.1); }
.tag-3 { color: #dc2626; background: rgba(220, 38, 38, 0.1); }
.tag--1 { color: #c1a06e; background: rgba(193, 160, 110, 0.1); }
