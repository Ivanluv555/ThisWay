<wxs module="drawer" src="./drawer.wxs" />

<view class="container">
  <map id="cidiMap" class="map-layer"
       latitude="{{latitude}}" longitude="{{longitude}}" scale="{{scale}}"
       markers="{{markers}}" show-location
       bindcallouttap="onCalloutTap"
       bindmarkertap="onMarkerTap"
       bindtap="onMapTap"
       bindregionchange="onMapRegionChange">

    <cover-view slot="callout">
      <block wx:for="{{markers}}" wx:key="id">
        <cover-view class="custom-marker" marker-id="{{item.id}}">
          <cover-view class="flame-badge flame-{{item.crowdLevel}}" wx:if="{{item.crowdDensity != null}}">
            <cover-view class="flame-text">🔥 {{item.crowdDensity}}</cover-view>
          </cover-view>
          <cover-view class="marker-img-wrap border-{{item.crowdLevel}}">
            <cover-image class="marker-img" src="{{item.image || 'https://picsum.photos/100/100?random=' + index}}" />
          </cover-view>
        </cover-view>
      </block>
    </cover-view>
  </map>

  <cover-view class="fs-btn" bindtap="toggleFullscreen">
    <cover-view class="fs-btn-text">{{viewMode === 'fullscreen' ? '退出' : '全屏'}}</cover-view>
  </cover-view>

  <cover-view class="locate-btn" bindtap="locateMe" wx:if="{{viewMode !== 'fullscreen'}}">
    <cover-view class="locate-btn-text">◎</cover-view>
  </cover-view>

  <view class="bottom-drawer {{viewMode === 'fullscreen' ? 'drawer-hidden' : ''}}"
        prop="{{drawerConfig}}"
        change:prop="{{drawer.propObserver}}">

    <view class="drawer-header"
          bindtouchstart="{{drawer.touchStart}}"
          catchtouchmove="{{drawer.touchMove}}"
          bindtouchend="{{drawer.touchEnd}}">
      <view class="drawer-handle"></view>
      <view class="search-box" catchtap="goSearch">
        <icon type="search" size="16" color="#a0a6b0"/>
        <text class="placeholder">搜索周边地点、帖子...</text>
      </view>
    </view>

    <scroll-view scroll-y class="poi-list">
      <view class="list-header">附近推荐</view>
      <block wx:for="{{markers}}" wx:key="id">
        <view class="poi-card" bindtap="onCalloutTap" data-marker-id="{{item.id}}">
          <image class="poi-img" src="{{item.image || 'https://picsum.photos/200/200?random=' + index}}" mode="aspectFill" />
          <view class="poi-info">
            <text class="poi-title">{{item.title}}</text>
            <text class="poi-desc">{{item.desc || '暂无简介'}}</text>
            <view class="poi-meta">
              <text class="distance">距您 {{item.distance || '1.2km'}}</text>
              <text class="tag tag-{{item.crowdLevel}}" wx:if="{{item.crowdLevel >= 0}}">{{item.crowdLevel === 0 ? '舒适' : item.crowdLevel === 1 ? '适中' : item.crowdLevel === 2 ? '拥挤' : '爆满'}}</text>
            </view>
          </view>
        </view>
      </block>
      <view style="height: 120rpx;"></view>
    </scroll-view>
  </view>
</view>
