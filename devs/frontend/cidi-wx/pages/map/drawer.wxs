var snapPoints = [0, 400, 700];
var lastTranslateY = 0;
var isDragging = false;
var startY = 0;
var dragStarted = false;

function propObserver(newValue, oldValue, ownerInstance, instance) {
  if (!newValue) return;
  if (newValue.snapPoints) {
    snapPoints = newValue.snapPoints;
  }

  // Initial setup on first load
  if (!oldValue) {
    var initY = snapPoints[0];
    lastTranslateY = initY;
    instance.setStyle({ transform: 'translateY(' + initY + 'px)' });
    return;
  }

  // JS triggered a snap change (e.g. focusMap, focusCards)
  if (!isDragging && newValue.current !== undefined && oldValue.current !== undefined) {
    if (newValue.current !== oldValue.current) {
      var idx = newValue.current;
      if (idx >= 0 && idx < snapPoints.length) {
        var targetY = snapPoints[idx];
        lastTranslateY = targetY;
        instance.addClass('drawer-animate');
        instance.setStyle({ transform: 'translateY(' + targetY + 'px)' });
      }
    }
  }
}

function touchStart(event, ownerInstance) {
  var touch = event.touches[0];
  startY = touch.clientY;
  dragStarted = true;
  isDragging = false;
  var instance = ownerInstance.selectComponent('.bottom-drawer');
  instance.removeClass('drawer-animate');
  return true;
}

function touchMove(event, ownerInstance) {
  if (!dragStarted) return true;
  var touch = event.touches[0];
  var deltaY = touch.clientY - startY;
  if (!isDragging && Math.abs(deltaY) > 6) {
    isDragging = true;
  }
  if (!isDragging) return true;

  var newY = lastTranslateY + deltaY;
  var minY = snapPoints[0];
  var maxY = snapPoints[snapPoints.length - 1];

  // Rubber-band resistance at edges
  if (newY < minY) newY = minY + (newY - minY) * 0.2;
  if (newY > maxY) newY = maxY + (newY - maxY) * 0.2;

  var instance = ownerInstance.selectComponent('.bottom-drawer');
  instance.setStyle({ transform: 'translateY(' + newY + 'px)' });
  return false;
}

function touchEnd(event, ownerInstance) {
  dragStarted = false;
  if (!isDragging) {
    isDragging = false;
    return;
  }
  isDragging = false;

  var touch = event.changedTouches[0];
  var deltaY = touch.clientY - startY;
  var currentY = lastTranslateY + deltaY;

  // Snap to nearest point
  var closestIdx = 0;
  var minDiff = Math.abs(currentY - snapPoints[0]);
  for (var i = 1; i < snapPoints.length; i++) {
    var diff = Math.abs(currentY - snapPoints[i]);
    if (diff < minDiff) {
      minDiff = diff;
      closestIdx = i;
    }
  }

  // Clamp to valid range
  if (currentY < snapPoints[0]) closestIdx = 0;
  if (currentY > snapPoints[snapPoints.length - 1]) closestIdx = snapPoints.length - 1;

  lastTranslateY = snapPoints[closestIdx];

  var instance = ownerInstance.selectComponent('.bottom-drawer');
  instance.addClass('drawer-animate');
  instance.setStyle({ transform: 'translateY(' + lastTranslateY + 'px)' });

  // Notify JS of new state
  ownerInstance.callMethod('onDrawerSnap', closestIdx);
}

module.exports = {
  propObserver: propObserver,
  touchStart: touchStart,
  touchMove: touchMove,
  touchEnd: touchEnd
}
