function touchMove(event, ownerInstance) {
  if (!dragStarted) return true;
  var touch = event.touches[0];
  var deltaY = touch.clientY - startY;
  if (!isDragging && Math.abs(deltaY) > 6) {
    isDragging = true;
  }
  if (!isDragging) return true;

  var newY = lastTranslateY + deltaY;
  var minY = snapPoints[0];
  var maxY = snapPoints[snapPoints.length - 1];

  // Rubber-band resistance at edges
  if (newY < minY) newY = minY + (newY - minY) * 0.2;
  if (newY > maxY) newY = maxY + (newY - maxY) * 0.2;

  var instance = ownerInstance.selectComponent('.bottom-drawer');
  instance.setStyle({ transform: 'translateY(' + newY + 'px)' });
  return false;
}

