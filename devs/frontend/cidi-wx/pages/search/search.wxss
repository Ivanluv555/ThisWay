.container {
  background: #f6f7f9;
  min-height: 100vh;
  box-sizing: border-box;
  display: block; /* 覆盖 app.wxss 的 flex 布局 */
  padding: 0;
}

.search-header {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  position: sticky;
  top: 0;
  background: #f6f7f9;
  z-index: 20;
  box-sizing: border-box;
}

.input-box {
  flex: 1;
  background: #fff;
  border-radius: 999rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  border: 1rpx solid #eceff3;
}

.input {
  flex: 1;
  margin: 0 16rpx;
  font-size: 28rpx;
  height: 100%;
  color: #222;
}

.discover-wrap {
  padding: 0 24rpx;
}

.history-panel,
.hot-panel {
  margin-top: 20rpx;
  padding: 22rpx;
  border-radius: 20rpx;
  background: #fff;
  border: 1rpx solid #f0f1f3;
  box-shadow: 0 8rpx 22rpx rgba(16, 24, 40, 0.05);
}

.panel-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 18rpx;
}

.panel-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #222;
}

.clear-history {
  font-size: 24rpx;
  color: #9097a3;
}

.hot-subtitle {
  font-size: 23rpx;
  color: #a3aab5;
}

.tags-row {
  display: flex;
  flex-wrap: wrap;
}

.tag {
  background: #f7f8fa;
  color: #626976;
  font-size: 24rpx;
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  margin: 0 16rpx 16rpx 0;
}

.empty-history {
  font-size: 24rpx;
  color: #a3aab5;
  padding: 6rpx 0 4rpx;
}

.hot-item {
  display: flex;
  align-items: center;
  padding: 16rpx 4rpx;
  border-bottom: 1rpx solid #f5f6f8;
}

.hot-item:last-child {
  border-bottom: none;
}

.hot-rank {
  width: 44rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.hot-rank-top {
  color: #ff5b46;
}

.hot-rank-normal {
  color: #9ca3af;
}

.hot-text {
  flex: 1;
  font-size: 26rpx;
  color: #222;
  line-height: 1.4;
}

.hot-num {
  margin-left: 16rpx;
  font-size: 22rpx;
  color: #a3aab5;
}

.result-wrap {
  padding: 8rpx 12rpx 36rpx;
}

.state-tip {
  text-align: center;
  color: #8f96a2;
  font-size: 25rpx;
  padding: 48rpx 0;
}

.state-tip.error {
  color: #d46a6a;
}

/* Tab bar */
.tab-bar {
  display: flex;
  padding: 0 12rpx;
  margin-bottom: 16rpx;
  border-bottom: 1rpx solid #eceff3;
  position: sticky;
  top: 104rpx;
  background: #f6f7f9;
  z-index: 10;
}

.tab-item {
  padding: 16rpx 10rpx;
  margin-right: 36rpx;
  font-size: 26rpx;
  color: #8f96a2;
  border-bottom: 4rpx solid transparent;
  transition: color 0.15s;
}

.tab-item.tab-active {
  color: #222;
  font-weight: 600;
  border-bottom-color: #1d4ed8;
}

.section {
  margin-top: 10rpx;
}

.section-title {
  font-size: 24rpx;
  color: #8f96a2;
  margin: 8rpx 4rpx 16rpx;
  font-weight: 500;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  border: 1rpx solid #f0f1f3;
  box-shadow: 0 8rpx 22rpx rgba(16, 24, 40, 0.05);
}

.res-item {
  display: flex;
  margin-bottom: 18rpx;
  padding: 18rpx;
}

.res-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.res-title {
  font-size: 28rpx;
