<view class="page-wrap">
  <view class="hero">
    <text class="hero-main">智能分流推荐</text>
    <text class="hero-sub">基于实时预测，避开拥挤景区</text>
  </view>

  <view class="glass-panel location-panel location-denied" wx:if="{{locationDenied}}" bindtap="handleLocationAuth">
    <text class="panel-title">当前位置</text>
    <text class="location-main">{{currentLocationLabel}}</text>
    <text class="location-detail">点击此处打开设置授权定位</text>
  </view>

  <view class="glass-panel location-panel" wx:else>
    <text class="panel-title">当前位置</text>
    <text class="location-main">{{currentLocationLabel}}</text>
    <text class="location-detail" wx:if="{{currentSpot}}">
      最近景区：{{currentSpot.title}} · {{currentSpot.distanceText}}
    </text>
  </view>

  <view class="glass-panel best-panel" wx:if="{{bestSpot}}" bindtap="goLocation" data-id="{{bestSpot.id}}">
    <text class="panel-title">首推景区</text>
    <view class="best-row">
      <image class="best-cover" src="{{bestSpot.image}}" mode="aspectFill" />
      <view class="best-info">
        <text class="best-name">{{bestSpot.title}}</text>
        <text class="best-category">{{bestSpot.category}}</text>
        <view class="best-tags">
          <text class="badge badge-{{bestSpot.congestionLevel}}">{{bestSpot.levelText}}</text>
          <text class="best-tag-item" wx:if="{{bestSpot.visitorCount != null}}">预测 {{bestSpot.visitorCount}} 人</text>
          <text class="best-tag-item" wx:if="{{bestSpot.crowdDensity != null}}">密度 {{bestSpot.crowdDensity}}</text>
        </view>
        <view class="best-meta-row">
          <text>距离 {{bestSpot.distanceText}}</text>
          <text class="best-trend">· {{bestSpot.trendLabel}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="list-head">
    <text class="list-title">推荐景区 Top 5</text>
    <text class="list-time" wx:if="{{updatedAt}}">更新于 {{updatedAt}}</text>
  </view>

  <view class="recommend-list" wx:if="{{topList.length}}">
    <block wx:for="{{topList}}" wx:key="id">
      <view class="glass-panel rank-item" bindtap="goLocation" data-id="{{item.id}}">
        <view class="rank-left">
          <text class="rank-num">{{item.rank}}</text>
          <view class="rank-body">
            <view class="rank-title-row">
              <text class="rank-name">{{item.title}}</text>
              <text class="badge badge-{{item.congestionLevel}}">{{item.levelText}}</text>
            </view>
            <text class="rank-desc">{{item.category}}</text>
            <view class="rank-meta-row">
              <text>距离 {{item.distanceText}}</text>
              <text wx:if="{{item.crowdDensity != null}}">· 密度 {{item.crowdDensity}}</text>
              <text>· {{item.trendLabel}}</text>
            </view>
          </view>
        </view>
      </view>
    </block>
  </view>

  <view class="empty-block" wx:if="{{!loading && !topList.length}}">
    <text>{{errorMsg || '暂无推荐数据'}}</text>
  </view>
</view>
