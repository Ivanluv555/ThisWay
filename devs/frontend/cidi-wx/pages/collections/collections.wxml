<view class="container">
  <view class="header">
    <text class="title">我的收藏</text>
    <text class="subtitle">{{list.length}} 个内容</text>
  </view>
  
  <view class="list-container">
    <block wx:for="{{list}}" wx:key="id">
      <view class="list-item" bindtap="goDetail" data-id="{{item.id}}">
        <image src="{{item.coverUrl}}" mode="aspectFill" class="cover-img"/>
        
        <view class="content-box">
          <text class="item-title">{{item.title}}</text>
          
          <view class="meta-row">
            <text class="meta-text UP">UP {{item.author}}</text>
            <text class="meta-text">{{item.date}}</text>
          </view>
        </view>
      </view>
    </block>
  </view>
</view>