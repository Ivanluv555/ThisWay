.page-wrap {
  padding: 26rpx 24rpx 34rpx;
  box-sizing: border-box;
}

.hero {
  margin: 8rpx 8rpx 26rpx;
}

.hero-main {
  display: block;
  font-size: 38rpx;
  font-weight: 700;
  color: #1f2937;
  line-height: 1.3;
}

.hero-sub {
  display: block;
  margin-top: 6rpx;
  font-size: 26rpx;
  color: #6b7280;
}

.glass-panel {
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 18rpx;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.78) 0%, rgba(255, 255, 255, 0.30) 100%);
  border: 1rpx solid rgba(255, 255, 255, 0.62);
  box-shadow: 0 16rpx 36rpx rgba(15, 23, 42, 0.1);
  backdrop-filter: blur(20px) saturate(165%);
  -webkit-backdrop-filter: blur(20px) saturate(165%);
}

.panel-title {
  display: block;
  font-size: 24rpx;
  color: #6b7280;
  margin-bottom: 10rpx;
}

.location-main {
  display: block;
  font-size: 32rpx;
  color: #111827;
  font-weight: 700;
  line-height: 1.4;
}

.location-detail {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #4b5563;
}

.location-panel.location-denied {
  border: 2rpx solid rgba(59, 130, 246, 0.42);
}

.location-panel.location-denied:active {
  background: linear-gradient(135deg, rgba(239, 246, 255, 0.82) 0%, rgba(219, 234, 254, 0.40) 100%);
}

/* Best spot card */
.best-row {
  display: flex;
  align-items: center;
}

.best-cover {
  width: 132rpx;
  height: 132rpx;
  border-radius: 18rpx;
  margin-right: 18rpx;
  flex-shrink: 0;
}

.best-info {
  display: flex;
  flex-direction: column;
  min-width: 0;
  flex: 1;
}

.best-name {
  font-size: 30rpx;
  color: #111827;
  font-weight: 700;
  margin-bottom: 4rpx;
}

.best-category {
  font-size: 22rpx;
  color: #6b7280;
  margin-bottom: 8rpx;
}

.best-tags {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 6rpx;
}

.best-tag-item {
  font-size: 22rpx;
  color: #4b5563;
}

.best-meta-row {
  display: flex;
  align-items: center;
  font-size: 22rpx;
  color: #6b7280;
}

.best-trend {
  color: #7c3aed;
}

/* Congestion badge */
.badge {
  display: inline-block;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.6;
}

.badge-0 {
  color: #16a34a;
  background: rgba(22, 163, 74, 0.12);
}

.badge-1 {
  color: #ca8a04;
  background: rgba(202, 138, 4, 0.12);
}

.badge-2 {
  color: #ea580c;
  background: rgba(234, 88, 12, 0.12);
}

.badge-3 {
  color: #dc2626;
  background: rgba(220, 38, 38, 0.12);
}

/* List */
.list-head {
  margin: 24rpx 4rpx 12rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.list-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2937;
}

.list-time {
  font-size: 22rpx;
  color: #6b7280;
}

.rank-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 22rpx;
  margin-bottom: 14rpx;
}

.rank-left {
  display: flex;
  align-items: center;
  min-width: 0;
  flex: 1;
}

.rank-num {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  text-align: center;
  line-height: 44rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #1d4ed8;
  background: rgba(191, 219, 254, 0.62);
  margin-right: 14rpx;
  flex-shrink: 0;
}

.rank-body {
  min-width: 0;
  flex: 1;
}

.rank-title-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.rank-name {
  font-size: 28rpx;
  color: #111827;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.rank-desc {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #6b7280;
}

.rank-meta-row {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #6b7280;
}

.empty-block {
  margin-top: 30rpx;
  text-align: center;
  color: #6b7280;
  font-size: 26rpx;
}
