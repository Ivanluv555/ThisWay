.page-wrap {
  padding: 26rpx 24rpx 34rpx;
  box-sizing: border-box;
}

.hero {
  position: relative;
  min-height: 110rpx;
  margin: 8rpx 8rpx 26rpx;
}

.hero-main,
.hero-sub {
  position: absolute;
  font-size: 40rpx;
  font-weight: 700;
  color: #1f2937;
  line-height: 1.25;
}

.hero-main {
  top: 0;
  left: 0;
}

.hero-sub {
  right: 0;
  bottom: 0;
}

.glass-panel {
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 18rpx;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.78) 0%, rgba(255, 255, 255, 0.30) 100%);
  border: 1rpx solid rgba(255, 255, 255, 0.62);
  box-shadow: 0 16rpx 36rpx rgba(15, 23, 42, 0.1);
  backdrop-filter: blur(20px) saturate(165%);
  -webkit-backdrop-filter: blur(20px) saturate(165%);
}

.panel-title {
  display: block;
  font-size: 24rpx;
  color: #6b7280;
  margin-bottom: 10rpx;
}

.location-main {
  display: block;
  font-size: 32rpx;
  color: #111827;
  font-weight: 700;
  line-height: 1.4;
}

.location-detail {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #4b5563;
}

.location-panel.location-denied {
  border: 2rpx solid rgba(59, 130, 246, 0.42);
}

.location-panel.location-denied:active {
  background: linear-gradient(135deg, rgba(239, 246, 255, 0.82) 0%, rgba(219, 234, 254, 0.40) 100%);
}

.best-row {
  display: flex;
  align-items: center;
}

.best-cover {
  width: 132rpx;
  height: 132rpx;
  border-radius: 18rpx;
  margin-right: 18rpx;
  flex-shrink: 0;
}

.best-info {
  display: flex;
  flex-direction: column;
}

.best-name {
  font-size: 30rpx;
  color: #111827;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.best-meta {
  font-size: 23rpx;
  color: #4b5563;
  line-height: 1.5;
}

.list-head {
  margin: 24rpx 4rpx 12rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.list-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2937;
}

.list-time {
  font-size: 22rpx;
  color: #6b7280;
}

.rank-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 22rpx;
  margin-bottom: 14rpx;
}

.rank-left {
  display: flex;
  align-items: center;
  min-width: 0;
}

.rank-num {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  text-align: center;
  line-height: 44rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #1d4ed8;
  background: rgba(191, 219, 254, 0.62);
  margin-right: 14rpx;
  flex-shrink: 0;
}

.rank-body {
  min-width: 0;
}

.rank-name {
  display: block;
  font-size: 28rpx;
  color: #111827;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.rank-desc {
  display: block;
  margin-top: 4rpx;
  font-size: 23rpx;
  color: #4b5563;
}

.rank-trend {
  font-size: 23rpx;
  color: #7c3aed;
  margin-left: 12rpx;
  flex-shrink: 0;
}

.empty-block {
  margin-top: 30rpx;
  text-align: center;
  color: #6b7280;
  font-size: 26rpx;
}