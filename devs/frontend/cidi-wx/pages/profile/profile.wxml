<view class="container">
  
  <view class="user-card" bindtap="handleLogin">
    <view class="user-main">
      <image class="avatar" 
             src="{{userInfo.avatarUrl || 'https://api.multiavatar.com/default.png'}}" 
             mode="aspectFill" />
      
      <view class="info-area">
        <text class="username">{{userInfo.username}}</text>
        <text class="bio">{{userInfo.bio}}</text>
      </view>
    </view>
  </view>

  <view class="stats-card">
     <view class="stat-item">
        <text class="stat-num">{{stats.likes}}</text>
        <text class="stat-label">获赞</text>
      </view>
      <view class="stat-item">
        <text class="stat-num">{{stats.following}}</text>
        <text class="stat-label">关注</text>
      </view>
      <view class="stat-item">
        <text class="stat-num">{{stats.followers}}</text>
        <text class="stat-label">粉丝</text>
      </view>
  </view>

  <view class="menu-list">
    <view class="menu-item" bindtap="navTo" data-page="collections">
      <view class="menu-left">
        <text class="menu-icon">★</text>
        <text class="menu-name">我的收藏</text>
      </view>
      <text class="arrow">></text>
    </view>

    <view class="menu-item" bindtap="navTo" data-page="feedback">
      <view class="menu-left">
        <text class="menu-icon">✎</text>
        <text class="menu-name">意见反馈</text>
      </view>
      <text class="arrow">></text>
    </view>
    
    <view class="menu-item" bindtap="navTo" data-page="settings">
      <view class="menu-left">
        <text class="menu-icon">⚙</text>
        <text class="menu-name">账户设置</text>
      </view>
      <text class="arrow">></text>
    </view>
  </view>
  
  <view class="footer-version">v 1.0.2 Beta</view>

</view>