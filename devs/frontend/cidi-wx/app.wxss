.container {
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  padding: 0;
  box-sizing: border-box;
}

page {
  background-color: #F7F8FA; /* 雅灰背景 */
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, sans-serif;
  --primary-black: #2C2C2C;
  --accent-gold: #C1A06E;
  color: #2C2C2C;
}