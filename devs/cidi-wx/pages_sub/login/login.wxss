.container { padding: 80rpx; align-items: stretch; }
.logo { font-size: 100rpx; color: #1296db; text-align: center; margin-bottom: 20rpx; }
.title { font-size: 40rpx; text-align: center; margin-bottom: 80rpx; }
.form-group { display: flex; align-items: center; border-bottom: 1rpx solid #eee; padding: 20rpx 0; }
.icon { margin-right: 20rpx; color: #999; }
.input { flex: 1; }
.login-btn { background: #1296db; color: #fff; margin-top: 80rpx; }
.links { display: flex; justify-content: space-between; font-size: 26rpx; color: #666; margin-top: 30rpx; }