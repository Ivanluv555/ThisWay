<view class="container">
  <view class="header">
    <text class="username">用户的名字</text> 
  </view>

  <view class="content-list">
    <block wx:for="{{contentList}}" wx:key="id">
      <view class="content-item">
        <image class="item-cover" src="{{item.coverUrl}}" mode="aspectFill" />
        <view class="item-info">
          <text class="item-title">{{item.title}}</text> 
          <view class="item-meta">
            <text class="item-author">{{item.author}} {{item.date}}</text> 
            <text class="item-collections">{{item.collections}}收藏</text> 
          </view>
        </view>
      </view>
    </block>
  </view>
</view>