.profile-header { display: flex; align-items: center; padding: 40rpx; background: #fff; }
.avatar { width: 120rpx; height: 120rpx; border-radius: 50%; }
.info { margin-left: 30rpx; }
.username { font-size: 36rpx; font-weight: bold; display: block; }
.bio { font-size: 26rpx; color: #999; margin-top: 10rpx; }
.menu-list { margin-top: 20rpx; background: #fff; }
.menu-item { display: flex; justify-content: space-between; padding: 30rpx; border-bottom: 1rpx solid #f4f4f4; }
.arrow { color: #ccc; }