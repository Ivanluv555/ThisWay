<view class="container">
  <view class="profile-header">
    <image class="avatar" src="{{userInfo.avatarUrl || '/images/avatar_placeholder.png'}}" />
    <view class="info">
      <text class="username">{{userInfo.username || '请登录'}}</text> 
      <text class="bio">{{userInfo.bio || '一句话用户介绍'}}</text> 
    </view>
  </view>

  <view class="menu-list">
    <view class="menu-item">
      <text>个人资料</text> 
      <text class="arrow">></text> 
    </view>
    <view class="menu-item">
      <text>足迹</text> 
      <text class="arrow">></text> 
    </view>
    <view class="menu-item">
      <text>账户设置</text> 
      <text class="arrow">></text> 
    </view>
    <view class="menu-item">
      <text>意见反馈</text> 
      <text class="arrow">></text> 
    </view>
  </view>
</view>