.container { position: relative; width: 100%; height: 100vh; }
.search-bar {
  position: absolute;
  top: 20rpx;
  left: 20rpx;
  right: 20rpx;
  z-index: 10;
  display: flex;
}
.search-input {
  flex: 1;
  background: #fff;
  border-radius: 30rpx;
  padding: 15rpx 30rpx;
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.1);
}