/* 页面容器占满全屏 */
page {
  height: 100%;
  overflow: hidden;
}

.container {
  width: 100%;
  height: 100%;
  position: relative;
  display: flex;
  flex-direction: column;
}

/* --- 1. 背景层 --- */
.bg-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: -2; /* 放在最底层 */
}

/* 黑色半透明蒙层，防止背景太花看不清字 */
.bg-mask {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(to bottom, rgba(0,0,0,0.1), rgba(0,0,0,0.8));
  z-index: -1;
}

/* --- 2. 内容包装层 --- */
.content-wrapper {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between; /* 顶部分布 Logo，底部分布按钮 */
  padding: 120rpx 60rpx 100rpx;
  box-sizing: border-box;
  color: #fff;
}

/* --- 顶部品牌区 --- */
.brand-section {
  display: flex;
  align-items: center;
  margin-top: 60rpx;
}

.logo-box {
  width: 100rpx;
  height: 100rpx;
  background: rgba(255,255,255,0.2); /* 半透明玻璃感 */
  backdrop-filter: blur(10px); /* 磨砂效果 (iOS支持较好) */
  border: 1rpx solid rgba(255,255,255,0.3);
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 30rpx;
}

.logo-text {
  font-size: 50rpx;
  color: #fff;
  font-weight: bold;
}

.text-group {
  display: flex;
  flex-direction: column;
}

.app-en {
  font-size: 48rpx;
  font-weight: 900;
  letter-spacing: 4px;
  line-height: 1;
  margin-bottom: 10rpx;
}

.app-cn {
  font-size: 24rpx;
  letter-spacing: 2px;
  opacity: 0.8;
  font-weight: 300;
}

/* --- 底部操作区 --- */
.action-section {
  width: 100%;
  animation: fadeInUp 0.8s ease-out; /* 简单的入场动画 */
}

.slogan-box {
  margin-bottom: 60rpx;
}

.slogan-main {
  display: block;
  font-size: 56rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
}

.slogan-sub {
  display: block;
  font-size: 28rpx;
  opacity: 0.7;
}

/* 微信按钮 */
.btn-wx {
  background: #07C160 !important;
  color: #fff;
  border-radius: 100rpx;
  padding: 0;
  height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center; /* 按钮内容居中 */
  font-size: 32rpx;
  font-weight: 600;
  width: 100% !important;
  box-shadow: 0 10rpx 30rpx rgba(7, 193, 96, 0.4); /* 绿色发光阴影 */
  border: none;
  position: relative;
}

.btn-wx:active {
  transform: scale(0.98);
  opacity: 0.9;
}

.wx-icon-bg {
  width: 44rpx;
  height: 44rpx;
  background: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  font-size: 20rpx;
}

/* 协议文字 */
.agreement-box {
  margin-top: 40rpx;
  text-align: center;
}

.agree-text {
  font-size: 22rpx;
  color: rgba(255,255,255,0.5);
}

/* 动画定义 */
@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(40rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}