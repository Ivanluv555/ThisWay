<view class="container">
  <view class="search-bar" bindtap="goSearch">
    <input class="search-input" placeholder="就是此地..." />
  </view>
  
  <map id="cidiMap" style="width: 100%; height: 100vh;"
       latitude="{{latitude}}" longitude="{{longitude}}" scale="{{scale}}" 
       markers="{{markers}}" show-location 
       bindcallouttap="onCalloutTap"
       bindmarkertap="onMarkerTap"
       bindtap="onMapTap">
  </map>
</view>