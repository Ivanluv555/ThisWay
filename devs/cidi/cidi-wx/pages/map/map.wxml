<view class="container">
  <view class="search-bar">
    <input class="search-input" placeholder="搜索任何兴趣点！" /> 
  </view>
  <map
    id="amap"
    style="width: 100%; height: 100vh;"
    longitude="{{longitude}}"
    latitude="{{latitude}}"
    scale="{{scale}}"
    markers="{{markers}}"
    show-location
    bindmarkertap="onMarkerTap"
    bindcallouttap="onCalloutTap"
  >
  </map>
</view>