<view class="container">
  <view class="search-bar">
    <input class="search-input" placeholder="Search Places..." />
  </view>
  <map id="cidiMap" style="width: 100%; height: 100vh;" 
       latitude="{{latitude}}" longitude="{{longitude}}" scale="{{scale}}" 
       markers="{{markers}}" show-location bindcallouttap="onCalloutTap">
  </map>
</view>