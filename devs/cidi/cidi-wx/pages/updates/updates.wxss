.search-bar { display: flex; padding: 20rpx 0; background: #fff; align-items: center; position: sticky; top: 0; z-index: 10; }
.search-input { flex: 1; background: #F7F8FA; border-radius: 0; padding: 16rpx 30rpx; font-size: 26rpx; }
.add-btn { font-size: 48rpx; padding: 0 30rpx; color: #2C2C2C; font-weight: 300; line-height: 1; }

.waterfall-container { display: flex; padding: 30rpx 15rpx; width: 100%; box-sizing: border-box; }
.waterfall-column { width: 50%; padding: 0 15rpx; }
.card { background: #fff; border-radius: 6rpx; overflow: hidden; margin-bottom: 30rpx; border: 1rpx solid rgba(0,0,0,0.04); }
.card-image { width: 100%; display: block; background: #eee; }
.card-title { font-size: 26rpx; padding: 20rpx; color: #333; font-weight: 500; }
.card-footer { display: flex; align-items: center; padding: 0 20rpx 24rpx; justify-content: space-between; }
.card-avatar { width: 32rpx; height: 32rpx; border-radius: 50%; background: #eee; }
.card-likes { font-size: 20rpx; color: #C1A06E; }