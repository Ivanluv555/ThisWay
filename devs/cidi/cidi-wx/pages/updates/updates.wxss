.search-bar { 
  display: flex; 
  padding: 20rpx 0; 
  background: #fff; 
  align-items: center; 
  position: sticky; 
  top: 0; 
  width: 100%; 
  z-index: 10; 
}

.search-input { 
  flex: 1; 
  background: #F7F8FA; 
  border-radius: 0; 
  padding: 16rpx 30rpx; 
  font-size: 26rpx; 
  margin-left: 30rpx;
  margin-right: 30rpx;
}

.waterfall-container { 
  display: flex; 
  padding: 30rpx 15rpx; 
  width: 100%; 
  box-sizing: border-box; 
}

.waterfall-column { 
  width: 50%; 
  padding: 0 15rpx; 
}

.card {
  background: #fff;
  border-radius: 6rpx; 
  overflow: hidden; 
  margin-bottom: 30rpx; 
  border: 1rpx solid rgba(0,0,0,0.04); 
}

.card-image { width: 100%; display: block; background: #eee; }
.card-title { font-size: 26rpx; padding: 20rpx; color: #333; font-weight: 500; }
.card-footer { display: flex; align-items: center; padding: 0 20rpx 24rpx; justify-content: space-between; }
.card-avatar { width: 32rpx; height: 32rpx; border-radius: 50%; background: #eee; }
.card-likes { font-size: 20rpx; color: #C1A06E; }

/* 悬浮按钮样式 */
.fab-btn {
  position: fixed;
  bottom: 60rpx;
  right: 40rpx;
  width: 110rpx;
  height: 110rpx;
  background: #2C2C2C; /* 深邃黑 */
  color: #C1A06E;      /* 品牌金 */
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 30rpx rgba(44, 44, 44, 0.4); /* 高级投影 */
  z-index: 100;
  transition: transform 0.2s cubic-bezier(0.25, 0.8, 0.25, 1);
}

.fab-btn text {
  font-size: 70rpx;
  font-weight: 300;
  line-height: 1;
  margin-top: -8rpx; /* 微调垂直居中 */
}

/* 点击时的缩放反馈 */
.fab-btn:active {
  transform: scale(0.9);
  box-shadow: 0 6rpx 16rpx rgba(44, 44, 44, 0.3);
}