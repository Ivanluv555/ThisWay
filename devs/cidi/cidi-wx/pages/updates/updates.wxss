.search-bar { display: flex; padding: 20rpx; background: #fff; align-items: center; }
.search-input { flex: 1; background: #f4f4f4; border-radius: 30rpx; padding: 10rpx 30rpx; }
.add-btn { font-size: 50rpx; margin-left: 20rpx; color: #1296db; }
.waterfall-container { display: flex; padding: 10rpx; }
.waterfall-column { width: 50%; padding: 0 10rpx; }
.card { background: #fff; border-radius: 10rpx; overflow: hidden; margin-bottom: 20rpx; }
.card-image { width: 100%; background: #eee; }
.card-title { font-size: 28rpx; padding: 10rpx; }
.card-footer { display: flex; align-items: center; padding: 10rpx; }
.card-avatar { width: 40rpx; height: 40rpx; border-radius: 50%; }
.card-username { font-size: 24rpx; color: #666; margin-left: 10rpx; flex: 1; }
.card-likes { font-size: 24rpx; color: #999; }