.header { width: 100%; padding: 40rpx; background: #fff; box-sizing: border-box; }
.title { font-size: 40rpx; font-weight: bold; color: #2C2C2C; display: block; }
.subtitle { font-size: 24rpx; color: #999; margin-top: 10rpx; display: block; }
.grid { width: 100%; padding: 20rpx; display: flex; flex-wrap: wrap; box-sizing: border-box; }
.grid-item { width: 50%; padding: 15rpx; box-sizing: border-box; }
.thumb { width: 100%; height: 240rpx; border-radius: 4rpx; background: #eee; }
.info { margin-top: 10rpx; }
.item-title { font-size: 26rpx; font-weight: 500; color: #333; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }