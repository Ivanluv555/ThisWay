page {
  background-color: #ffffff; /* 改为纯白背景，更干净 */
}

.container {
  padding-bottom: 40rpx;
}

/* --- Hero 区域 --- */
.hero-area {
  padding: 40rpx 40rpx 20rpx;
}

.hero-title {
  font-size: 60rpx;
  font-weight: 800;
  color: #2C2C2C;
  line-height: 1.1;
  letter-spacing: -1px;
  margin-bottom: 40rpx;
  display: block;
  font-family: 'Helvetica Neue', sans-serif;
}

.search-box {
  background: #F7F8FA;
  border-radius: 40rpx;
  padding: 24rpx 30rpx;
  display: flex;
  align-items: center;
}

.ph-style {
  color: #bbb;
  font-size: 28rpx;
  margin-left: 20rpx;
}

/* --- 分类滚动栏 --- */
.category-scroll {
  display: flex;
  white-space: nowrap;
  padding: 20rpx 40rpx;
  height: 100rpx; /* 给足够的高度放阴影和圆点 */
  box-sizing: border-box;
}

.category-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  margin-right: 50rpx;
  color: #999;
  font-size: 30rpx;
  font-weight: 500;
  position: relative;
  transition: all 0.3s;
}

.category-item.active {
  color: #2C2C2C;
  font-size: 32rpx;
  font-weight: bold;
}

.active-dot {
  width: 8rpx;
  height: 8rpx;
  background: #C1A06E; /* 品牌金 */
  border-radius: 50%;
  margin-top: 10rpx;
  position: absolute;
  bottom: -15rpx;
}

/* --- 沉浸式卡片流 --- */
.feed-list {
  padding: 20rpx 40rpx;
}

.card {
  background: #fff;
  border-radius: 24rpx; /* 大圆角 */
  overflow: hidden;
  margin-bottom: 60rpx; /* 卡片间距拉大，呼吸感 */
  box-shadow: 0 10rpx 40rpx rgba(0,0,0,0.06); /* 高级感的弥散阴影 */
}

.card-cover {
  width: 100%;
  height: 420rpx; /* 图片加高，视觉冲击力 */
  display: block;
}

.card-info {
  padding: 30rpx;
}

.card-tag {
  display: inline-block;
  background: rgba(0,0,0,0.03);
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  margin-bottom: 20rpx;
}
.card-tag text {
  font-size: 22rpx;
  color: #555;
  font-weight: 600;
}

.card-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #2C2C2C;
  line-height: 1.4;
  margin-bottom: 30rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.card-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.author-box {
  display: flex;
  align-items: center;
}

.author-face {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  border: 1rpx solid #eee;
}

.author-name {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
}

.likes-box {
  display: flex;
  align-items: center;
  color: #999;
}

/* 【新增】首页卡片小图标样式 */
.card-icon {
  width: 32rpx;  /* 设置合适的大小 */
  height: 32rpx;
  margin-right: 8rpx;
  opacity: 0.6; /* 稍微淡一点，显高级 */
}

.like-num {
  font-size: 24rpx;
  font-weight: 500; /* 数字稍微加粗一点 */
  color: #666; /* 颜色加深一点，更清晰 */
}