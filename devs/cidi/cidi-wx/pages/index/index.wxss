.header { display: flex; align-items: center; padding: 20rpx; background: #fff; }
.avatar { width: 80rpx; height: 80rpx; border-radius: 50%; margin-right: 20rpx; }
.username { font-size: 32rpx; }
.content-list { width: 100%; }
.content-item { background: #fff; margin: 20rpx; border-radius: 10rpx; overflow: hidden; }
.item-cover { width: 100%; height: 300rpx; background: #eee; }
.item-info { padding: 20rpx; }
.item-title { font-size: 30rpx; font-weight: bold; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; }
.item-meta { display: flex; justify-content: space-between; font-size: 24rpx; color: #999; margin-top: 10rpx; }