.header { display: flex; align-items: center; padding: 40rpx; background: rgba(255,255,255,0.95); position: sticky; top: 0; z-index: 99; }
.avatar { width: 70rpx; height: 70rpx; border-radius: 50%; margin-right: 20rpx; border: 1rpx solid #ddd; }
.username { font-size: 36rpx; font-weight: bold; letter-spacing: 1px; }
.content-list { width: 100%; padding-bottom: 40rpx; }
.content-item { background: #fff; margin: 40rpx 30rpx; border-radius: 4rpx; overflow: hidden; box-shadow: 0 20rpx 40rpx -10rpx rgba(0,0,0,0.08); }
.item-cover { width: 100%; height: 400rpx; background: #eee; }
.item-info { padding: 30rpx; }
.item-title { font-size: 34rpx; font-weight: 600; margin-bottom: 20rpx; line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.item-meta { display: flex; justify-content: space-between; font-size: 22rpx; color: #999; text-transform: uppercase; letter-spacing: 1px; }