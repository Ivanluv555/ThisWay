page {
  background-color: #f7f8fa;
}

.container {
  padding-bottom: 40rpx;
}

/* --- Sticky Header --- */
.sticky-header {
  position: sticky;
  top: 0;
  z-index: 99;
  background-color: #fff;
  padding-bottom: 10rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.03);
  transition: all 0.3s ease;
}

/* --- Top Bar (Title + Search) --- */
.hero-area {
  padding: 30rpx 40rpx 10rpx;
  display: flex;
  flex-direction: column;
  transition: all 0.3s ease;
}

.hero-title {
  font-size: 60rpx;
  font-weight: 800;
  color: #2C2C2C;
  line-height: 1.1;
  letter-spacing: -1px;
  margin-bottom: 30rpx;
  font-family: 'Helvetica Neue', sans-serif;
  transition: all 0.3s ease;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.search-box {
  background: #F7F8FA;
  border-radius: 40rpx;
  padding: 24rpx 30rpx;
  display: flex;
  align-items: center;
  transition: all 0.3s ease;
}

.ph-style {
  color: #bbb;
  font-size: 28rpx;
  margin-left: 20rpx;
}

/* --- Shrunk State --- */
.sticky-header.shrunk .hero-area {
  padding: 10rpx 30rpx 0;
  flex-direction: row;
  align-items: center;
  justify-content: flex-start;
}

.sticky-header.shrunk .hero-title {
  font-size: 32rpx;
  margin-bottom: 0;
  margin-right: 20rpx;
  max-width: 300rpx; 
}

.sticky-header.shrunk .search-box {
  flex: 1;
  padding: 12rpx 24rpx;
  height: 64rpx;
}

/* --- 分类滚动栏 --- */
.category-scroll {
  display: flex;
  white-space: nowrap;
  padding: 20rpx 40rpx;
  height: 90rpx;
  box-sizing: border-box;
}

.category-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  margin-right: 50rpx;
  color: #999;
  font-size: 28rpx;
  font-weight: 500;
  position: relative;
  transition: all 0.3s;
}

.category-item.active {
  color: #2C2C2C;
  font-size: 30rpx;
  font-weight: bold;
}

/* --- 沉浸式卡片流 (双列) --- */
.feed-list {
  padding: 20rpx;
  column-count: 2;
  column-gap: 20rpx;
}

.card {
  break-inside: avoid;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
  width: 100%;
  
  /* Fix layout issues in column-count */
  display: inline-block;
  vertical-align: top;
}

.card-cover {
  width: 100%;
  height: auto; 
  aspect-ratio: 3/4; /* 保持竖图比例，或根据需要调整 */
  display: block;
}

.card-info {
  padding: 20rpx;
}

.card-tag {
  display: inline-block;
  background: rgba(0,0,0,0.03);
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  margin-bottom: 20rpx;
}
.card-tag text {
  font-size: 22rpx;
  color: #555;
  font-weight: 600;
}

.card-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #2C2C2C;
  line-height: 1.4;
  margin-bottom: 30rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.card-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.author-box {
  display: flex;
  align-items: center;
}

.author-face {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  border: 1rpx solid #eee;
}

.author-name {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
}

.likes-box {
  display: flex;
  align-items: center;
  color: #999;
}

/* 【新增】首页卡片小图标样式 */
.card-icon {
  width: 32rpx;  /* 设置合适的大小 */
  height: 32rpx;
  margin-right: 8rpx;
  opacity: 0.6; /* 稍微淡一点，显高级 */
}

.like-num {
  font-size: 24rpx;
  font-weight: 500; /* 数字稍微加粗一点 */
  color: #666; /* 颜色加深一点，更清晰 */
}