page {
  background-color: #F7F8FA; /* 浅灰底色，衬托卡片 */
}

.container {
  padding: 30rpx 40rpx;
}

/* --- 1. 用户信息卡片 --- */
.user-card {
  background: #fff;
  border-radius: 32rpx; /* 更大的圆角 */
  padding: 50rpx 40rpx;
  margin-bottom: 40rpx;
  box-shadow: 0 10rpx 40rpx rgba(0,0,0,0.05); /* 悬浮感阴影 */
  position: relative;
  overflow: hidden;
}

.user-info-row {
  display: flex;
  align-items: center;
  margin-bottom: 40rpx;
}

.avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: #eee;
  border: 6rpx solid #fff; /* 白色描边增加精致感 */
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.1);
}

.info-text {
  margin-left: 30rpx;
  flex: 1;
}

.username {
  font-size: 44rpx; /* 大字体 */
  font-weight: 800;
  color: #2C2C2C;
  display: block;
  margin-bottom: 10rpx;
  letter-spacing: -0.5px;
}

.bio {
  font-size: 26rpx;
  color: #999;
  display: block;
}

.login-arrow {
  background: #2C2C2C;
  color: #C1A06E;
  font-size: 24rpx;
  font-weight: bold;
  padding: 12rpx 30rpx;
  border-radius: 40rpx;
}

/* 数据概览栏 */
.stats-row {
  display: flex;
  justify-content: space-around; /* 平均分布 */
  border-top: 1rpx solid #f9f9f9;
  padding-top: 40rpx;
}

.stat-item {
  text-align: center;
}

.stat-num {
  font-size: 36rpx;
  font-weight: bold;
  color: #2C2C2C;
  display: block;
}

.stat-label {
  font-size: 22rpx;
  color: #bbb;
  margin-top: 6rpx;
  display: block;
  text-transform: uppercase; /* 大写更有设计感 */
  letter-spacing: 1px;
}

/* --- 2. 菜单卡片 --- */
.menu-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 10rpx 0; /* 上下留点白 */
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.03);
  width: 85%;
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 34rpx 40rpx;
  /* 去掉 border-bottom，更极简 */
}

.menu-item:active {
  background-color: #f9f9f9; /* 点击反馈 */
}

.menu-left {
  display: flex;
  align-items: center;
}

.menu-icon {
  font-size: 36rpx;
  margin-right: 24rpx;
  color: #2C2C2C;
  width: 50rpx; /* 固定宽度确保文字对齐 */
  text-align: center;
}

.menu-name {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
}

.arrow {
  font-size: 24rpx;
  color: #ddd;
}

/* --- 底部版本号 --- */
.footer-version {
  text-align: center;
  color: #ccc;
  font-size: 22rpx;
  margin-top: 60rpx;
  letter-spacing: 1px;
}