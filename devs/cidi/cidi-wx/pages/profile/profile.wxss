.profile-header { width: 100%; display: flex; align-items: center; padding: 100rpx 50rpx 80rpx; background: #2C2C2C; color: #fff; box-sizing: border-box; }
.avatar { width: 140rpx; height: 140rpx; border-radius: 50%; border: 4rpx solid rgba(255,255,255,0.2); }
.info { margin-left: 40rpx; }
.username { font-size: 44rpx; font-weight: bold; display: block; letter-spacing: 1px; }
.bio { font-size: 24rpx; color: rgba(255,255,255,0.6); margin-top: 10rpx; display: block; }
.menu-list { width: 100%; background: #fff; min-height: 600rpx; }
.menu-item { display: flex; justify-content: space-between; padding: 40rpx 50rpx; border-bottom: 1rpx solid #f9f9f9; font-size: 30rpx; color: #333; }
.arrow { color: #ddd; }