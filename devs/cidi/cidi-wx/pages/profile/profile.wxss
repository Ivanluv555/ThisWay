/* pages/profile/profile.wxss */
.container {
  min-height: 100vh;
  background: #f6f7f9;
  box-sizing: border-box;
  padding: 24rpx;
  display: block; /* 覆盖 app.wxss 全局 flex */
}

/* --- 用户信息卡片 --- */
.user-card {
  padding: 40rpx 20rpx;
  margin-bottom: 24rpx;
  /* 去掉卡片背景，让头像更加沉浸 */
}

.user-main {
  display: flex;
  align-items: center;
}

.avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: #fff;
  border: 4rpx solid #fff;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
}

.info-area {
  margin-left: 32rpx;
  flex: 1;
}

.username {
  font-size: 44rpx;
  font-weight: 600;
  color: #222;
  display: block;
  margin-bottom: 8rpx;
  line-height: 1.2;
}

.bio {
  font-size: 26rpx;
  color: #9097a3;
  display: block;
}

/* --- 数据概览栏 (新风格: 独立卡片) --- */
.stats-card {
  background: #fff;
  border-radius: 20rpx;
  display: flex;
  justify-content: space-between;
  padding: 30rpx 40rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid #f0f1f3;
  box-shadow: 0 8rpx 22rpx rgba(16, 24, 40, 0.05); /* 统一卡片阴影 */
}

.stat-item {
  text-align: center;
  flex: 1;
}

.stat-num {
  font-size: 32rpx;
  font-weight: 600;
  color: #222;
  display: block;
  margin-bottom: 4rpx;
}

.stat-label {
  font-size: 22rpx;
  color: #9097a3;
  display: block;
}

/* --- 菜单列表 (新风格: 卡片式分组) --- */
.menu-list {
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  border: 1rpx solid #f0f1f3;
  box-shadow: 0 8rpx 22rpx rgba(16, 24, 40, 0.05);
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 30rpx;
  position: relative;
}

/* 分割线：除了最后一项都有 */
.menu-item:not(:last-child)::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 30rpx; 
  right: 30rpx;
  height: 1rpx;
  background: #f5f6f8;
}

.menu-item:active {
  background-color: #f9fafa;
}

.menu-left {
  display: flex;
  align-items: center;
}

.menu-icon {
  font-size: 34rpx;
  margin-right: 24rpx;
  color: #555;
  width: 40rpx;
  text-align: center;
}

.menu-name {
  font-size: 28rpx;
  color: #222;
  font-weight: 500;
}

.arrow {
  font-size: 24rpx;
  color: #c0c4cc;
}

/* --- 底部版本号 --- */
.footer-version {
  text-align: center;
  color: #cfd3dc;
  font-size: 22rpx;
  margin-top: 60rpx;
  padding-bottom: 40rpx;
}