.container { background: #fff; min-height: 100vh; }

/* 顶部栏 */
.search-header {
  display: flex; align-items: center; padding: 20rpx 30rpx;
  position: sticky; top: 0; background: #fff; z-index: 99;
  border-bottom: 1rpx solid #f5f5f5;
}
.input-box {
  flex: 1; background: #F7F8FA; border-radius: 40rpx;
  height: 72rpx; display: flex; align-items: center; padding: 0 24rpx;
}
.input { flex: 1; margin: 0 16rpx; font-size: 28rpx; height: 100%; }
.cancel-btn { font-size: 30rpx; color: #666; margin-left: 24rpx; }

/* 历史记录 */
.history-panel { padding: 40rpx 30rpx; }
.panel-header { display: flex; justify-content: space-between; margin-bottom: 24rpx; }
.panel-title { font-size: 28rpx; font-weight: bold; color: #333; }
.tags-row { display: flex; flex-wrap: wrap; }
.tag {
  background: #F7F8FA; color: #666; font-size: 24rpx;
  padding: 12rpx 24rpx; border-radius: 8rpx; margin: 0 20rpx 20rpx 0;
}

/* 结果列表 */
.result-list { height: calc(100vh - 120rpx); }
.section { padding: 30rpx; }
.section-title { font-size: 24rpx; color: #999; margin-bottom: 20rpx; font-weight: bold; }

.res-item { display: flex; margin-bottom: 30rpx; }
.res-info { flex: 1; display: flex; flex-direction: column; justify-content: center; }
.res-title { font-size: 30rpx; color: #333; margin-bottom: 8rpx; font-weight: 500;}
.res-sub { font-size: 24rpx; color: #999; }

/* 地点特有样式 */
.loc-icon { 
  width: 80rpx; height: 80rpx; background: #EBFAF3; color: #07C160;
  border-radius: 12rpx; margin-right: 24rpx; 
  display: flex; align-items: center; justify-content: center; font-size: 36rpx;
}

/* 文章特有样式 */
.res-cover {
  width: 120rpx; height: 120rpx; border-radius: 12rpx; background: #eee;
  margin-right: 24rpx;
}

.empty-tip { text-align: center; margin-top: 100rpx; color: #ccc; font-size: 28rpx; }